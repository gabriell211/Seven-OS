#!/bin/sh

BINFMT_DIR="/proc/sys/fs/binfmt_misc"
REGISTER="$BINFMT_DIR/register"

register_handler() {
	name="$1"
	spec="$2"

	[ -e "$BINFMT_DIR/$name" ] && return 0
	printf '%s\n' "$spec" > "$REGISTER"
}

start() {
	[ -x /usr/bin/seven-winexec ] || return 0

	mkdir -p "$BINFMT_DIR"

	if ! grep -qs " $BINFMT_DIR binfmt_misc " /proc/mounts 2>/dev/null; then
		mount -t binfmt_misc binfmt_misc "$BINFMT_DIR" 2>/dev/null || return 0
	fi

	[ -w "$REGISTER" ] || return 0

	# MZ is the DOS header used by PE executables. The compatibility
	# runtime performs complete PE validation after Seven WinExec receives it.
	register_handler "seven-pe" ':seven-pe:M::MZ::/usr/bin/seven-winexec:'
	register_handler "seven-msi" ':seven-msi:E::msi::/usr/bin/seven-winexec:'
	register_handler "seven-msi-upper" ':seven-msi-upper:E::MSI::/usr/bin/seven-winexec:'
}

stop() {
	for name in seven-pe seven-msi seven-msi-upper; do
		if [ -w "$BINFMT_DIR/$name" ]; then
			printf '%s\n' -1 > "$BINFMT_DIR/$name"
		fi
	done
}

case "${1:-start}" in
	start) start ;;
	stop) stop ;;
	restart)
		stop
		start
		;;
	*) exit 1 ;;
esac
