#!/bin/sh
set -eu

CONFIG_FILE="/etc/seven/seven-windows.conf"

if [ -r "$CONFIG_FILE" ]; then
	# shellcheck disable=SC1090
	. "$CONFIG_FILE"
fi

SEVEN_WINDOWS_ENABLED="${SEVEN_WINDOWS_ENABLED:-1}"
SEVEN_WINDOWS_WINE_BINARY="${SEVEN_WINE_BINARY:-${SEVEN_WINDOWS_WINE_BINARY:-wine}}"
SEVEN_WINDOWS_DEBUG="${SEVEN_WINDOWS_DEBUG:--all}"
SEVEN_WINDOWS_ARCH="${SEVEN_WINDOWS_ARCH:-}"

die() {
	printf 'seven-win: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage:
  seven-winexec <program.exe> [arguments...]
  seven-winexec <installer.msi> [arguments...]
  seven-winexec --install <installer.exe|installer.msi> [arguments...]
  seven-winexec --prefix <program.exe|installer.msi>
  seven-winexec --status
  seven-winexec --version
EOF
}

status() {
	printf 'Seven WinExec: 0.1.0\n'

	if command -v "$SEVEN_WINDOWS_WINE_BINARY" >/dev/null 2>&1; then
		printf 'Windows runtime: available (%s)\n' "$SEVEN_WINDOWS_WINE_BINARY"
	else
		printf 'Windows runtime: missing\n'
	fi

	if [ -e /dev/ntsync ]; then
		printf 'NTSYNC: available\n'
	else
		printf 'NTSYNC: unavailable\n'
	fi

	if [ -e /proc/sys/fs/binfmt_misc/seven-pe ]; then
		printf 'PE handler: registered\n'
	else
		printf 'PE handler: not registered\n'
	fi
}

[ "$SEVEN_WINDOWS_ENABLED" = "1" ] || die "Windows compatibility is disabled."

mode="run"
case "${1:-}" in
	--install)
		mode="install"
		shift
		;;
	--prefix)
		mode="prefix"
		shift
		;;
	--status)
		status
		exit 0
		;;
	--version)
		printf 'Seven WinExec 0.1.0\n'
		exit 0
		;;
	-h|--help|"")
		usage
		exit 0
		;;
esac

target="${1:-}"
[ -n "$target" ] || die "no Windows executable was provided."
shift

if command -v readlink >/dev/null 2>&1; then
	resolved="$(readlink -f "$target" 2>/dev/null || true)"
else
	resolved=""
fi

if [ -z "$resolved" ]; then
	case "$target" in
		/*) resolved="$target" ;;
		*) resolved="$(pwd)/$target" ;;
	esac
fi

[ -f "$resolved" ] || die "file not found: $target"

base="$(basename "$resolved")"
safe_base="$(printf '%s' "$base" | tr -c 'A-Za-z0-9._-' '_')"
path_id="$(printf '%s' "$resolved" | cksum | awk '{print $1}')"

if [ -n "${SEVEN_WINDOWS_PREFIX_ROOT:-}" ]; then
	prefix_root="$SEVEN_WINDOWS_PREFIX_ROOT"
else
	data_home="${XDG_DATA_HOME:-${HOME:-/tmp}/.local/share}"
	prefix_root="$data_home/seven/windows/apps"
fi

if [ -n "${SEVEN_WINDOWS_PREFIX:-}" ]; then
	prefix="$SEVEN_WINDOWS_PREFIX"
else
	case "$resolved" in
		"$prefix_root"/*/drive_c/*)
			relative="${resolved#"$prefix_root"/}"
			prefix_name="${relative%%/drive_c/*}"
			prefix="$prefix_root/$prefix_name"
			;;
		*)
			prefix="$prefix_root/${safe_base}-${path_id}"
			;;
	esac
fi

if [ "$mode" = "prefix" ]; then
	printf '%s\n' "$prefix"
	exit 0
fi

command -v "$SEVEN_WINDOWS_WINE_BINARY" >/dev/null 2>&1 || {
	die "Wine runtime is not installed. Install the Seven Windows Runtime first."
}

mkdir -p "$prefix"

export WINEPREFIX="$prefix"
if [ -n "$SEVEN_WINDOWS_ARCH" ]; then
	export WINEARCH="$SEVEN_WINDOWS_ARCH"
else
	unset WINEARCH 2>/dev/null || true
fi

export WINEDEBUG="${WINEDEBUG:-$SEVEN_WINDOWS_DEBUG}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winemenubuilder.exe=d}"

case "$resolved" in
	*.msi|*.MSI)
		exec "$SEVEN_WINDOWS_WINE_BINARY" msiexec /i "$resolved" "$@"
		;;
	*.exe|*.EXE)
		exec "$SEVEN_WINDOWS_WINE_BINARY" "$resolved" "$@"
		;;
	*)
		if [ "$mode" = "install" ]; then
			die "installer must be an .exe or .msi file."
		fi
		exec "$SEVEN_WINDOWS_WINE_BINARY" "$resolved" "$@"
		;;
esac
