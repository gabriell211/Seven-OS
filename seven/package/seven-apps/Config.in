config BR2_PACKAGE_SEVEN_APPS
	bool "Seven core desktop applications"
	depends on BR2_PACKAGE_SEVEN_DESKTOP
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_NETWORK
	select BR2_PACKAGE_QT6DECLARATIVE
	select BR2_PACKAGE_QT6DECLARATIVE_QUICK
	select BR2_PACKAGE_FOOT
	help
	  Core Seven applications: Files, Settings, Store, System Monitor
	  and the Seven Terminal launcher.
