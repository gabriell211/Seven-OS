[Unit]
Description=Seven Audio Session Manager
ConditionKernelCommandLine=!seven.recovery=1
Requires=seven-pipewire.service
After=seven-pipewire.service dbus.service
Before=seven-desktop.service

[Service]
Type=simple
User=seven
Group=seven
SupplementaryGroups=audio video
Environment=XDG_RUNTIME_DIR=/run/seven
Environment=PIPEWIRE_RUNTIME_DIR=/run/seven
ExecStart=/usr/bin/wireplumber
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical.target
